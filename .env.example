# ---------------------------------------------------------------
# Finanzas personales — configuración
# Copiá este archivo a .env y ajustá los valores
# ---------------------------------------------------------------

# Base de datos (SQLite por defecto, ideal para un solo usuario).
# Para multiusuario en serio: PostgreSQL (mismo código, solo cambia la URL).
# Requiere el driver psycopg (ya está en requirements.txt).
# Ejemplo local: creado con
#   initdb -D /tmp/pgdata -U postgres --auth=trust
#   pg_ctl -D /tmp/pgdata -l pg.log -o "-p 5433" start
#   psql -h localhost -p 5433 -U postgres -c "CREATE ROLE franco LOGIN;"
#   psql -h localhost -p 5433 -U postgres -c "CREATE DATABASE finanzas OWNER franco;"
# DATABASE_URL=postgresql+psycopg://franco@127.0.0.1:5433/finanzas
DATABASE_URL=sqlite:///./finanzas.db

# Moneda usada para mostrar montos
CURRENCY=ARS

# --- Agente -----------------------------------------------------
# Sin API key el agente corre en MODO DEMO (respuestas simuladas,
# útil para probar el flujo sin gastar nada).
# Con una key usa OpenAI o cualquier endpoint compatible
# (OpenRouter, Ollama, LM Studio, vLLM, etc).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Forzar modo demo aunque exista una key
# LLM_MOCK=1

# Umbral (en la moneda configurada) a partir del cual REGISTRAR
# una transacción requiere confirmación tuya.
# Eliminar transacciones, objetivos o presupuestos SIEMPRE requiere confirmación.
SENSITIVE_AMOUNT=50000

# Fracción del presupuesto mensual a partir de la cual la categoría
# pasa a estado "atención" (0.8 = 80%). Pasado el 100% queda "excedido".
# Es el mismo número que usan el panel y el agente.
BUDGET_ALERT_PCT=0.8

# Días que vive una sesión antes de exigir login de nuevo.
# Un token es un secreto que viaja en un header; si se filtra, el acceso
# no puede depender de que el dueño se acuerde de hacer logout.
SESSION_TTL_DAYS=30

# Servidor
HOST=127.0.0.1
PORT=8000